{
  "name": "v1-library-organizer",
  "version": "1.0.13",
  "description": "Electron desktop app to organize a DJ's music collection. macOS only for now.",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --mac --dir -c.mac.identity=null",
    "dist:install": "electron-vite build && electron-builder --mac --dir -c.mac.identity=null && scripts/install-release.sh",
    "dist:beta": "electron-vite build && electron-builder --mac --dir -c.mac.identity=null -c.appId=com.local.music-collection-organizer.beta -c.productName=\"MCO - Music Collection Organizer BETA\" -c.mac.icon=resources/icon-beta.png -c.extraMetadata.name=v1-library-organizer-beta && scripts/install-beta.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "build": {
    "appId": "com.local.music-collection-organizer",
    "productName": "MCO - Music Collection Organizer",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "target": "dir",
      "identity": null,
      "icon": "resources/icon.png"
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "electron-store": "^11.0.2",
    "essentia.js": "^0.1.3",
    "ffmpeg-static": "^5.3.0",
    "material-symbols": "^0.46.0",
    "music-metadata": "^11.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}
