<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the signed/notarized release build.
  Electron's V8 (and essentia.js's WebAssembly) need JIT and writable
  executable memory. Nothing else is granted: the app never records audio,
  and every bundled binary (Electron frameworks, ffmpeg) is signed with the
  same team ID, so library validation can stay on.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
